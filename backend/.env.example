GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_WINDOW_SECONDS=45
TOP_K=5
MAX_DISTANCE=1.2

# Optional — only for `python -m app.ingest` when YouTube IP-blocks you (cloud IPs, or a
# home IP rate-limited after many requests). Leave blank to fetch directly.
#
# Ingest already retries blocked videos via yt-dlp automatically. Point it at your browser's
# cookies to make that fallback far more reliable on a soft-blocked home IP (be logged into
# YouTube in that browser). One of: chrome | firefox | edge | safari | brave.
YTDLP_COOKIES_FROM_BROWSER=
# Last resort for a hard block (e.g. cloud IP): a Webshare residential proxy
# (https://www.webshare.io — pick "Residential").
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
